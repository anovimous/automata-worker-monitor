# The env of the workers of the template whose envFile is "default": today's orchestrator/.env of the worker repo,
# without WORKER_ID, TELEMETRY_ADDR, WORKER_SOCKET_DIR, TEMP_DIR, WORDLIST_CACHE_DIR, WORDLIST_CACHE_MAX_BYTES and
# LOG_FORMAT, which the worker machine controller sets itself. Keep this file mode 600: it holds credentials.
# On the machine of the core's compose stack, with the template network automata_backend, use the service names:
RABBITMQ_URL=amqp://automata:CHANGE_ME@rabbitmq:5672/
RABBITMQ_QUEUE=jobs.http.queue
RUSTFS_ENDPOINT=rustfs:9000
RUSTFS_ACCESS_KEY=automata
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_JOBS_BUCKET=job-configuration
RUSTFS_RESULTS_BUCKET=job-results
RUSTFS_WORDLISTS_BUCKET=wordlists
CENTRAL_BASE_URL=http://app:8080
CENTRAL_POLL_INTERVAL_SECONDS=5
CENTRAL_STATE_ENDPOINT=/api/external/jobs/http/poll
CENTRAL_OUTCOME_ENDPOINT=/api/external/jobs/http/update
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
