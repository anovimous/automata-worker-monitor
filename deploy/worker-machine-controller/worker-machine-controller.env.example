# The token of the workers control plane, at least 32 characters: head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
WORKER_MACHINE_CONTROLLER_TOKEN=
# The name of this host in the monitor and in the worker ids (lowercase letters, digits, -)
WORKER_MACHINE_CONTROLLER_HOST_NAME=host1
# Loopback by default. Another address needs TLS (the two paths below), or ALLOW_PLAINTEXT=true on a trusted network.
WORKER_MACHINE_CONTROLLER_LISTEN_ADDR=127.0.0.1:9480
#WORKER_MACHINE_CONTROLLER_TLS_CERT=/etc/automata-worker-machine-controller/tls/cert.pem
#WORKER_MACHINE_CONTROLLER_TLS_KEY=/etc/automata-worker-machine-controller/tls/key.pem
#WORKER_MACHINE_CONTROLLER_ALLOW_PLAINTEXT=false
# The images workers may be created from (comma-separated glob patterns)
WORKER_MACHINE_CONTROLLER_ALLOWED_IMAGES=automata-worker:*
# Telemetry ports of host-network workers
WORKER_MACHINE_CONTROLLER_HOST_PORT_RANGE=19100-19199
# Disk usage reported for these paths (the host's / is mounted at /host)
WORKER_MACHINE_CONTROLLER_DISK_PATHS=/host/var/lib/docker
LOG_FORMAT=json
