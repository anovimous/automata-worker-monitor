# STAGE 1: BUILDER
FROM golang:1.26 AS builder

ARG VERSION=dev
ARG COMMIT=unknown

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 go build \
  -ldflags "-X github.com/anovimous/automata-worker-monitor/internal/buildinfo.Version=${VERSION} \
  -X github.com/anovimous/automata-worker-monitor/internal/buildinfo.Commit=${COMMIT}" \
  -o /bin/worker-machine-controller ./cmd/worker-machine-controller

# STAGE 2: RUNNER. Root (user 0): the controller talks to docker.sock. Pinned by digest: static-debian12 of 2026-10-30.
FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2

ARG VERSION=dev
ARG COMMIT=unknown
LABEL org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.revision=${COMMIT} \
      org.opencontainers.image.source=https://github.com/anovimous/automata-worker-monitor

COPY --from=builder /bin/worker-machine-controller /usr/local/bin/worker-machine-controller

# the host's /proc, /sys and / are mounted here (deploy/worker-machine-controller/docker-compose.yml)
ENV HOST_PROC=/host/proc HOST_SYS=/host/sys HOST_ROOT=/host

ENTRYPOINT ["/usr/local/bin/worker-machine-controller"]
