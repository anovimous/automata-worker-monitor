# STAGE 1: BUILDER (the web UI stage comes with P5; until then the binary serves a placeholder page)
FROM golang:1.26 AS builder

ARG VERSION=dev
ARG COMMIT=unknown

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 go build \
  -ldflags "-X github.com/anovimous/automata-worker-monitor/internal/buildinfo.Version=${VERSION} \
  -X github.com/anovimous/automata-worker-monitor/internal/buildinfo.Commit=${COMMIT}" \
  -o /bin/workers-control-plane ./cmd/workers-control-plane
# the database directory, owned by the nonroot user so that a new volume gets that owner
RUN mkdir -p /data/var/lib/automata-monitor

# STAGE 2: RUNNER. Nonroot; pinned by digest: static-debian12:nonroot of 2026-10-30.
FROM gcr.io/distroless/static-debian12@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

ARG VERSION=dev
ARG COMMIT=unknown
LABEL org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.revision=${COMMIT} \
      org.opencontainers.image.source=https://github.com/anovimous/automata-worker-monitor

COPY --from=builder /bin/workers-control-plane /usr/local/bin/workers-control-plane
COPY --from=builder --chown=65532:65532 /data/var/lib/automata-monitor /var/lib/automata-monitor

ENV MONITOR_CONFIG=/etc/automata-monitor/config.yml
VOLUME /var/lib/automata-monitor
ENTRYPOINT ["/usr/local/bin/workers-control-plane"]
